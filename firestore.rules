rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authenticatedEmail() {
      return signedIn()
        && request.auth.token.email is string;
    }

    // Email-auth profiles are private to their owner. Privileged fields are
    // immutable from the client; admin roles must be assigned out-of-band.
    match /auth_users/{uid} {
      allow get: if authenticatedEmail() && request.auth.uid == uid;
      allow list: if false;
      allow create: if authenticatedEmail()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'displayName', 'email', 'role', 'isBlocked',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.isBlocked == false
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_-]{3,20}$')
        && (request.resource.data.username != 'serustqs' || request.auth.token.email == 'cheater.cooperation@inbox.ru')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40;
      allow update, delete: if false;
    }

    // Username documents are only readable one-at-a-time by verified users
    // for availability checks; public enumeration is disabled.
    match /auth_usernames/{username} {
      allow get: if authenticatedEmail();
      allow list: if false;
      allow create: if authenticatedEmail()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_-]{3,20}$')
        && (username != 'serustqs' || request.auth.token.email == 'cheater.cooperation@inbox.ru');
      allow update, delete: if false;
    }

    // Promo-code management is restricted to the explicitly approved Firebase account.
    function isPromoCodeAdmin() {
      return signedIn() && request.auth.uid == 'tZa25TCUCHXI8dfhhfC5mhSxq9J3';
    }

    match /promo_codes/{promoCodeId} {
      allow read, create, update, delete: if isPromoCodeAdmin();
    }

    // Public recruitment listings; editing is restricted to the listing owner.
    match /clan_posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.type in ['clan_recruit', 'player_lfg']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 3000
        && request.resource.data.hours is number
        && request.resource.data.hours >= 0
        && request.resource.data.hours <= 20000
        && request.resource.data.serverType is string
        && request.resource.data.discord is string
        && request.resource.data.discord.size() <= 100
        && request.resource.data.status == 'open';
      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'clanName', 'hours', 'serverType', 'teamSize', 'rolesNeeded',
            'primeTime', 'ageMin', 'description', 'discord', 'status', 'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 3000
          && request.resource.data.hours is number
          && request.resource.data.hours >= 0
          && request.resource.data.hours <= 20000
          && request.resource.data.serverType is string
          && request.resource.data.serverType.size() <= 60
          && request.resource.data.discord is string
          && request.resource.data.discord.size() >= 2
          && request.resource.data.discord.size() <= 100
          && request.resource.data.get('clanName', '') is string
          && request.resource.data.get('clanName', '').size() <= 60
          && request.resource.data.get('teamSize', '') is string
          && request.resource.data.get('teamSize', '').size() <= 60
          && request.resource.data.get('primeTime', '') is string
          && request.resource.data.get('primeTime', '').size() <= 60
          && request.resource.data.get('ageMin', 16) is number
          && request.resource.data.get('ageMin', 16) >= 12
          && request.resource.data.get('ageMin', 16) <= 99
          && request.resource.data.get('rolesNeeded', []) is list
          && request.resource.data.get('rolesNeeded', []).size() <= 7
          && request.resource.data.status in ['open', 'closed'])
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount is number
          && request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1)
      );
      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);
    }

    // Public discussion messages do not contain private application data.
    match /clan_comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);
    }

    // Applications are visible only to their applicant and the owner of the post.
    match /clan_tickets/{ticketId} {
      allow get, list: if signedIn()
        && (resource.data.applicantId == request.auth.uid || resource.data.postAuthorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'postId', 'postTitle', 'postAuthorId', 'applicantName', 'applicantId',
          'applicantAvatar', 'applicantHours', 'applicantAge', 'applicantRoles',
          'discord', 'message', 'createdAt', 'status'
        ])
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.postId is string
        && request.resource.data.postAuthorId is string
        && request.resource.data.postAuthorId != request.auth.uid
        && request.resource.data.applicantName is string
        && request.resource.data.applicantHours is number
        && request.resource.data.applicantHours >= 0
        && request.resource.data.applicantHours <= 20000
        && request.resource.data.discord is string
        && request.resource.data.discord.size() >= 2
        && request.resource.data.discord.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && get(/databases/$(database)/documents/clan_posts/$(request.resource.data.postId)).data.authorId == request.resource.data.postAuthorId
        && get(/databases/$(database)/documents/clan_posts/$(request.resource.data.postId)).data.status == 'open';
      allow update: if signedIn()
        && resource.data.postAuthorId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responseNote', 'updatedAt']);
      allow delete: if signedIn()
        && resource.data.applicantId == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Legacy collections are deliberately left unchanged in this migration.
    // Their existing rules should be reviewed in a separate compatibility pass.
    match /email_verification/{document} {
      allow read, write: if false;
    }
    match /chat_user_emails/{document} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusty.Lub",
  "version": "3.0.2",
  "identifier": "com.rustylub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rusty.Lub Desktop",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQUFEODNCQ0Y2QzJERkIKUldUN0xXelBPOWlxcnlxa01McW9ORWRLdVZWMDl0MFZtTWRIcG1iTzNFSG8yUmJKN3hTNFg1eUkK",
      "endpoints": [
        "https://github.com/RustyLub/Rusty.Lub/releases/latest/download/latest.json"
      ]
    }
  }
}
